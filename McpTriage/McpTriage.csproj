<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>McpTriage</RootNamespace>
    <AssemblyName>McpTriage</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The smoke test decrypts renewed tokens to keep the sign-in file in plain text -->
    <InternalsVisibleTo Include="McpTriage.Smoke" />
  </ItemGroup>

</Project>
